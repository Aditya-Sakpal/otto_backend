		{
			"name": "Webhooks",
			"item": [
				{
					"name": "Telephony - Call Complete",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Company-Id",
								"value": "{{company_id}}",
								"type": "text",
								"description": "Company UUID (can also be in payload)"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"company_id\": \"123e4567-e89b-12d3-a456-426614174001\",\n    \"phone_number\": \"+1234567890\",\n    \"audio_url\": \"https://example.com/audio/call-123.mp3\",\n    \"call_type\": \"csr_call\",\n    \"missed_call\": false,\n    \"duration_seconds\": 120,\n    \"metadata\": {\n        \"source\": \"callrail\",\n        \"tracking_number\": \"+1987654321\",\n        \"caller_id\": \"+1234567890\"\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/webhooks/telephony/call-complete",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"webhooks",
								"telephony",
								"call-complete"
							]
						},
						"description": "Webhook endpoint for telephony providers (CallRail, Twilio) to notify when a call is completed.\n\n**Note:** This endpoint does NOT require JWT authentication as it's called by external services. For production, implement webhook signature verification.\n\n**Request Body:**\n- `company_id` (required): Company UUID (can also be in X-Company-Id header)\n- `phone_number` (required): Phone number of the call\n- `audio_url` (required): URL to the call audio recording\n- `call_type` (required): Type of call (csr_call, sales_call, missed_call)\n- `missed_call` (optional): Whether the call was missed\n- `duration_seconds` (optional): Call duration in seconds"
					},
					"response": [
						{
							"name": "Success Response",
							"originalRequest": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									},
