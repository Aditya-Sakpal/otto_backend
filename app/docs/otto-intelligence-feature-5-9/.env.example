# Transcription Services (Optional)
SHUNYA_API_URL=
SHUNYA_API_KEY=
ASSEMBLYAI_API_KEY=

# AWS S3 (Optional - for audio storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
AWS_REGION=us-east-1

# Logging
LOG_LEVEL=INFO

# SOP Settings
# Default number of days to look back when re-analyzing calls with new SOP versions (Feature 6)
SOP_REANALYSIS_DEFAULT_LOOKBACK_DAYS=14
# Number of SOP metrics to evaluate per LLM call (chunking for cost efficiency)
# Lower = more calls but cheaper per call; Higher = fewer calls but more tokens needed
SOP_METRICS_CHUNK_SIZE=10
# Max completion tokens per chunk evaluation (needs to fit reasoning + JSON output)
SOP_EVAL_MAX_TOKENS_PER_CHUNK=4000
