# =============================================================================
# Otto Backend — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# NEVER commit real secrets. Share secrets with teammates out-of-band.
# =============================================================================

# --- Core ---
ENVIRONMENT=development
APP_ENV=DEV
LOG_LEVEL=INFO
API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
# PostgreSQL (app uses asyncpg): postgresql+asyncpg://user:password@host:5432/dbname
# Local SQLite alternative:      sqlite+aiosqlite:///./otto.db
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/otto
AUTO_CREATE_TABLES=true
LOCAL_DB_PATH=./otto.db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM providers ---
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=your-clerk-secret-key
CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_API_URL=https://api.clerk.com
CLERK_ISSUER=https://your-clerk-issuer
CLERK_FRONTEND_ORIGIN=http://localhost:3000
CLERK_WEBHOOK_SECRET=your-clerk-webhook-secret

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Twilio ---
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+10000000000
TWILIO_CALLBACK_NUMBER=+10000000000
TWILIO_API_BASE_URL=https://api.twilio.com

# --- CallRail ---
CALLRAIL_API_KEY=your-callrail-api-key
CALLRAIL_ACCOUNT_ID=your-callrail-account-id
CALLRAIL_BASE_URL=https://api.callrail.com

# --- Deepgram ---
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_API_BASE_URL=https://api.deepgram.com

# --- Bland ---
BLAND_API_KEY=your-bland-api-key

# --- Shoonya / UWC ---
UWC_BASE_URL=https://ottoai.shunyalabs.ai
UWC_API_KEY=your-uwc-api-key
UWC_HMAC_SECRET=your-uwc-hmac-secret
UWC_JWT_SECRET=your-uwc-jwt-secret

# --- Rate limiting ---
RATE_LIMIT_USER=100
RATE_LIMIT_TENANT=1000

# --- Follow-up / cadence engine ---
COMPANY_CONFIGS=
DRY_RUN=true
AUTO_EXECUTE=false
CADENCE_ATTEMPT_1_DAYS=1
CADENCE_ATTEMPT_2_DAYS=3
CADENCE_ATTEMPT_3_DAYS=7
MAX_ATTEMPTS=3
TIMING_OVERRIDE_MIN_CONFIDENCE=0.7
MASKED_COMMS_ENABLED=false
